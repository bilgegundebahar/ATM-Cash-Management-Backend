    "description": "Run in listed order. Current implementation uses a direct withdraw endpoint; quote/confirm reservations are unfinished."
  },
  "item": [
    {
      "name": "01 Create ATM",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/atms",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "atms"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demo ATM\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP success\", function () { pm.expect(pm.response.code).to.be.within(200,299); });",
              "let body = pm.response.json(); pm.collectionVariables.set(\"atmId\", body.id);"
            ]
          }
        }
      ]
    },
